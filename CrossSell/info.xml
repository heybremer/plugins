<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>CrossSell</Name>
    <Description>Urun detayinda ve sepette "Bunu da al" / tamamlayici urun onerileri. Hangi urunun hangi urunu onerecegi dashboard'dan secilir.</Description>
    <Author>Womosi</Author>
    <URL>https://womosi.de</URL>
    <XMLVersion>100</XMLVersion>
    <ShopVersion>5.2.0</ShopVersion>
    <PluginID>CrossSell</PluginID>
    <CreateDate>2026-11-05</CreateDate>
    <Version>1.0.0</Version>
    <Bootstrap>Plugin\CrossSell\Bootstrap</Bootstrap>
    <Install>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Oneriler</Name>
                <Filename>dashboard.php</Filename>
            </Customlink>
            <Settingslink sort="2">
                <Name>Ayarlar</Name>
                <Setting type="selectbox" initialValue="Y" sort="1" conf="Y">
                    <Name>Urun detayinda goster</Name>
                    <Description>Onerileri urun detay sayfasinda goster</Description>
                    <ValueName>cs_product_active</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="1">Evet</Option>
                        <Option value="N" sort="2">Hayir</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="selectbox" initialValue="Y" sort="2" conf="Y">
                    <Name>Sepette goster</Name>
                    <Description>Onerileri sepet sayfasinda goster</Description>
                    <ValueName>cs_cart_active</ValueName>
                    <SelectboxOptions>
                        <Option value="Y" sort="1">Evet</Option>
                        <Option value="N" sort="2">Hayir</Option>
                    </SelectboxOptions>
                </Setting>
                <Setting type="text" initialValue="Dazu passend" sort="3" conf="Y">
                    <Name>Baslik (urun detayi)</Name>
                    <Description>Urun detay sayfasindaki baslik</Description>
                    <ValueName>cs_title_product</ValueName>
                </Setting>
                <Setting type="text" initialValue="Das passt dazu" sort="4" conf="Y">
                    <Name>Baslik (sepet)</Name>
                    <Description>Sepet sayfasindaki baslik</Description>
                    <ValueName>cs_title_cart</ValueName>
                </Setting>
                <Setting type="text" initialValue="4" sort="5" conf="Y">
                    <Name>Maksimum urun sayisi</Name>
                    <Description>Bir seferde en fazla kac oneri gosterilsin (1-12)</Description>
                    <ValueName>cs_max_items</ValueName>
                </Setting>
                <Setting type="text" initialValue="" sort="6" conf="Y">
                    <Name>CSS selector (urun detayi, opsiyonel)</Name>
                    <Description>Bu elementin altina eklenir. Bos ise otomatik.</Description>
                    <ValueName>cs_selector_product</ValueName>
                </Setting>
                <Setting type="text" initialValue="" sort="7" conf="Y">
                    <Name>CSS selector (sepet, opsiyonel)</Name>
                    <Description>Bu elementin altina eklenir. Bos ise otomatik.</Description>
                    <ValueName>cs_selector_cart</ValueName>
                </Setting>
            </Settingslink>
        </Adminmenu>
    </Install>
</jtlshopplugin>
