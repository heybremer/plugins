{
    "name": "womosi/side-left-panel",
    "description": "JTL-Shop Plugin for Side Panel UX improvements",
    "type": "jtl-shop-plugin",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\SideLeftPanel\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\SideLeftPanel\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    }
}
