{
    "name": "womosi/filter-konfigurator-search",
    "description": "JTL-Shop Plugin for LiveSearch Filter Konfigurator",
    "type": "jtl-shop-plugin",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\FilterKonfiguratorSearch\\": "./",
            "Plugin\\FilterKonfiguratorSearch\\Controller\\": "./src/Controller/",
            "Plugin\\FilterKonfiguratorSearch\\Repository\\": "./src/Repository/",
            "Plugin\\FilterKonfiguratorSearch\\Query\\": "./src/Query/",
            "Plugin\\FilterKonfiguratorSearch\\Filter\\": "./src/Filter/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\FilterKonfiguratorSearch\\Tests\\": "tests/"
        }
    },
    "config": {
        "disable-tls": false,
        "secure-http": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    }
}
