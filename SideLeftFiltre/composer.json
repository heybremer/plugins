{
    "name": "womosi/side-left-filtre",
    "description": "JTL-Shop Plugin: Sorts filter blocks in the left sidepanel by configurable ID order.",
    "type": "jtl-shop-plugin",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\SideLeftFiltre\\": "./",
            "Plugin\\SideLeftFiltre\\src\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\SideLeftFiltre\\Tests\\": "tests/"
        }
    },
    "config": {
        "disable-tls": false,
        "secure-http": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    }
}
