<div id="rabatt-header-bar" class="rh-bar" role="region" aria-label="Rabatt-Aktion">
    <div class="rh-inner">
        <p class="rh-text">{$rhBannerHtml nofilter}</p>
        <button type="button" class="rh-code" data-rh-code="{$rhCouponCode|escape:'html'}" title="Gutscheincode kopieren" aria-label="Gutscheincode {$rhCouponCode|escape:'html'} kopieren">
            <span class="rh-code-label">Code</span>
            <span class="rh-code-value">{$rhCouponCode|escape:'html'}</span>
            <span class="rh-code-hint">Klicken zum Kopieren</span>
        </button>
    </div>
</div>
